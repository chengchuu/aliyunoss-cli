{
  "name": "aliyunoss-cli",
  "version": "1.3.0",
  "description": "Alibaba Cloud OSS file upload CLI.",
  "main": "lib/index.js",
  "bin": {
    "aliyunoss-cli": "./bin/index.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:tsc": "tsc --project tsconfig.json",
    "build:module": "rollup --config ./scripts/rollup.config.mjs",
    "build:dev": "webpack --config ./scripts/webpack.config.cjs",
    "build:site": "cross-env GITHUB_PAGES=true webpack --mode production --config ./scripts/webpack.config.cjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.library.json --noEmit && tsc --project tsconfig.site.json --noEmit",
    "lint": "npm run typecheck",
    "release:dev": "node bin/index.js --releaseEnv dev",
    "test": "node --test",
    "build": "npm run build:tsc && npm run build:module && npm run package:validate",
    "docs:api": "typedoc --tsconfig ./tsconfig.library.json --out ./dist-dev/api --readme ./README.md --excludeProtected --excludePrivate --excludeInternal --hideGenerator",
    "docs": "npm run build:site && npm run docs:api && node scripts/build-pages.cjs && npm run seo:validate && npm run pwa:validate",
    "seo:validate": "node scripts/validate-seo.cjs",
    "pwa:validate": "node scripts/validate-pwa.cjs",
    "package:validate": "node scripts/validate-package.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengchuu/aliyunoss-cli.git"
  },
  "keywords": [
    "upload",
    "ali",
    "aliyun",
    "oss",
    "cli"
  ],
  "author": "Cheng",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chengchuu/aliyunoss-cli/issues"
  },
  "homepage": "https://chengchuu.github.io/aliyunoss-cli/",
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bootstrap": "^5.3.8",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.7",
    "mazey": "^5.6.4",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.2",
    "ts-loader": "^9.6.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "minimist": "^1.2.8"
  }
}
