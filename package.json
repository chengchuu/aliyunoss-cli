{
  "name": "aliyunoss-cli",
  "version": "1.1.6",
  "description": "Alibaba Cloud OSS file upload CLI.",
  "main": "lib/index.js",
  "bin": {
    "aliyunoss-cli": "./bin/index.js"
  },
  "scripts": {
    "build:tsc": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "release:dev": "node bin/index.js --releaseEnv dev",
    "test": "node --test",
    "build": "npm run build:tsc"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengchuu/aliyunoss-cli.git"
  },
  "keywords": [
    "upload",
    "ali",
    "aliyun",
    "oss",
    "cli"
  ],
  "author": "Cheng",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chengchuu/aliyunoss-cli/issues"
  },
  "homepage": "https://github.com/chengchuu/aliyunoss-cli#readme",
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "minimist": "^1.2.8"
  }
}
